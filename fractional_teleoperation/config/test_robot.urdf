<?xml version="1.0" ?>
<robot name="explorer_test">
  <!-- Minimal URDF for testing fractional_teleoperation_controller without real hardware interfaces -->
  
  <link name="world"/>
  
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Dummy tool frame -->
  <link name="tool0">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="base_to_tool" type="fixed">
    <parent link="base_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- ros2_control section (required by controller_manager, even if empty) -->
  <ros2_control name="explorer_test" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
  </ros2_control>

</robot>

